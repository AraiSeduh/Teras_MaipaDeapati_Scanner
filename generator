});
$('seatMode').addEventListener('change',()=>{
  const manual=$('seatMode').value==='manual';
  $('manualArea').hidden=!manual;
  $('mapArea').hidden=manual;
  updateText();
});
$('session').addEventListener('change',()=>{
  selectedSeats=[];
  $('manualSeats').value='';
  refreshMap();
  updateText();
});
$('manualSeats').addEventListener('input',updateText);
$('createBtn').addEventListener('click',()=>runAction('create'));
$('reissueBtn').addEventListener('click',()=>runAction('reissue'));
$('downloadBtn').addEventListener('click',downloadPng);
$('nextBtn').addEventListener('click',nextTicket);
$('saveSettingsBtn').addEventListener('click',saveSettings);
$('pingBtn').addEventListener('click',pingServer);

$('urlInput').value=getUrl();
$('pinInput').value=getPin();
if(!getPin())$('settings').open=true;
refreshMap();
