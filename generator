<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Maipa Deapati Ticket Generator</title>
  <!-- Library QR: cdnjs dulu, kalau gagal coba jsDelivr -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
  <script>
    if (typeof qrcode !== 'function') {
      document.write('<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js"><\/script>');
    }
  </script>
  <style>
    :root{--wine:#501426;--dark:#240b14;--red:#a52b43;--gold:#d8b878;--cream:#fff8e9;--muted:#c9b7bd}
    *{box-sizing:border-box}
    body{margin:0;padding:20px;font-family:Arial,sans-serif;color:var(--cream);background:radial-gradient(ellipse at top,#4a1428,var(--dark) 70%);min-height:100vh}
    main{max-width:900px;margin:auto}
    header{text-align:center;padding:18px 8px 24px}
    .eyebrow{color:var(--gold);font-size:11px;letter-spacing:4px;text-transform:uppercase}
    h1{font:normal clamp(30px,7vw,44px) Georgia,serif;margin:13px 0 8px}
    header p{color:var(--muted);font-size:13px}
    .panel{background:linear-gradient(145deg,#3a1725,#2d101b);border:1px solid #754354;border-radius:16px;padding:22px;margin:16px 0;box-shadow:0 12px 30px #0003}
    .section-title{color:var(--gold);font-size:12px;letter-spacing:2px;margin:0 0 15px}
    label{display:block;font-size:13px;font-weight:bold;margin:15px 0 7px}
    input,select,textarea,button{width:100%;padding:12px;border-radius:9px;font:inherit;border:1px solid #75515c}
    input,select,textarea{color:#2b1720;background:#fffaf3}
    textarea{resize:vertical}
    button{border:1px solid var(--gold);background:var(--red);color:white;font-weight:bold;cursor:pointer;margin-top:12px}
    button.secondary{background:transparent;color:var(--cream)}
    button.next{background:#21834a;border-color:#7bd39e}
    button:disabled{opacity:.5;cursor:not-allowed}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .small{font-size:12px;line-height:1.65;color:var(--muted)}
    #status{margin-top:14px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.6}
    #seatMap{overflow-x:auto;padding:10px 0}
    .map-inner{min-width:570px;max-width:790px;margin:auto}
    .stage,.bottom-label{width:max-content;margin:8px auto 12px;background:linear-gradient(90deg,#d6a83f,#fff0b5,#d6a83f);color:#3b1b10;border-radius:25px;text-align:center;padding:8px 32px;font:16px Georgia,serif}
    .seat-row{display:grid;grid-template-columns:minmax(0,1fr) 27px minmax(0,1fr);align-items:center;margin:3px 0;min-height:24px}
    .side{display:flex;gap:3px;min-width:0;align-items:center}
    .side.left{justify-content:flex-end}
    .side.right{justify-content:flex-start}
    .row-label{text-align:center;color:#fff3db;font:bold 13px Georgia,serif}
    .seat{width:18px;min-width:18px;height:18px;padding:0;margin:0;border-radius:50%;font-size:8px;font-weight:bold;border:1px solid #ffda80;color:#26140a;display:flex;align-items:center;justify-content:center}
    .seat.voc{background:#f2df00}
    .seat.tubarani{background:#19c4e7}
    .seat.daeng{background:#f59a16}
    .seat.sultan{background:#ed252b;color:white}
    .seat.selected{outline:2px solid white;box-shadow:0 0 0 3px var(--gold)}
    .seat.occupied{background:#65575b!important;border-color:#82757a;color:#c9bfc1;opacity:.55}
    .seat-legend{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;font-size:11px;color:#d8c5cb;margin:12px 0}
    .legend-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px}
    .seat-pills{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
    .seat-pill{border:1px solid var(--gold);border-radius:20px;padding:6px 10px;font-size:12px}
    .info-chip{display:inline-block;border:1px solid var(--gold);border-radius:20px;padding:5px 10px;font-size:12px;color:var(--gold);margin-top:7px}
    #preview{display:none}
    #ticketCanvas{width:100%;max-width:500px;height:auto;display:block;margin:16px auto;background:#fff}
    details summary{cursor:pointer;color:var(--gold);font-size:12px;letter-spacing:2px;font-weight:bold}
    code{background:#0004;padding:1px 4px;border-radius:4px}
    footer{text-align:center;color:#a98b95;font-size:11px;padding:12px 10px 25px}
    @media(pointer:coarse){.seat{width:20px;min-width:20px;height:20px;font-size:9px}.map-inner{min-width:640px}}
    @media(max-width:550px){body{padding:10px}.panel{padding:15px}.two{grid-template-columns:1fr}}
  </style>
</head>
<body>
<main>
  <header>
    <div class="eyebrow">Official Ticket Generator</div>
    <h1>Maipa Deapati</h1>
    <p>Teater Musikal · Ticketing System</p>
  </header>

  <section class="panel">
    <details id="settings">
      <summary>00 — PENGATURAN KONEKSI</summary>
      <label for="urlInput">URL Web App (berakhiran /exec)</label>
      <input id="urlInput" type="text" autocomplete="off" spellcheck="false" placeholder="https://script.google.com/macros/s/.../exec">
      <label for="pinInput">PIN admin (sama dengan ADMIN_PIN di Code.gs)</label>
      <input id="pinInput" type="password" autocomplete="off" placeholder="PIN admin">
      <div class="two">
        <button id="saveSettingsBtn" type="button">SIMPAN</button>
        <button id="pingBtn" type="button" class="secondary">TES KONEKSI</button>
      </div>
      <p class="small">URL dan PIN disimpan di browser perangkat ini. URL yang sama dipakai juga oleh halaman scanner.</p>
      <div id="settingsStatus" class="small"></div>
    </details>
  </section>

  <section class="panel">
    <h2 class="section-title">01 — DATA TIKET</h2>
    <label for="name">Nama pemilik tiket</label>
    <input id="name" maxlength="120" placeholder="Masukkan nama penonton">

    <div class="two">
      <div>
        <label for="session">Sesi pertunjukan</label>
        <select id="session">
          <option>Sesi 1</option><option>Sesi 2</option><option>Sesi 3</option>
        </select>
      </div>
      <div>
        <label for="ticketMode">Mode tiket</label>
        <select id="ticketMode">
          <option value="create">Buat tiket baru</option>
          <option value="reissue">Buat ulang e-ticket lama</option>
        </select>
      </div>
    </div>

    <label for="seatMode">Metode pilih bangku</label>
    <select id="seatMode">
      <option value="map">Klik denah kursi</option>
      <option value="manual">Input manual</option>
    </select>
    <p class="small">Kategori ditentukan otomatis berdasarkan baris kursi. Kursi yang sudah terdaftar ditandai abu-abu.</p>
    <div id="categoryInfo" class="info-chip">Kategori: belum dipilih</div>
  </section>

  <section class="panel">
    <h2 class="section-title">02 — PILIH BANGKU</h2>
    <div id="mapArea"><div id="seatMap">Memuat denah...</div>
      <div class="seat-legend">
        <span><i class="legend-dot" style="background:#f2df00"></i>VOC</span>
        <span><i class="legend-dot" style="background:#19c4e7"></i>Tubarani</span>
        <span><i class="legend-dot" style="background:#f59a16"></i>Daeng</span>
        <span><i class="legend-dot" style="background:#ed252b"></i>Sultan</span>
        <span><i class="legend-dot" style="background:#65575b"></i>Terisi</span>
      </div>
    </div>

    <div id="manualArea" hidden>
      <label for="manualSeats">Daftar bangku</label>
      <textarea id="manualSeats" rows="3" placeholder="A1, A2, A3"></textarea>
    </div>

    <label>Bangku terpilih</label>
    <div id="selectedSeats" class="small">Belum ada bangku dipilih.</div>
    <div class="two">
      <button id="createBtn" type="button">Buat Tiket Baru</button>
      <button id="reissueBtn" type="button" class="secondary">Buat Ulang E-Ticket</button>
    </div>
    <p class="small">Buat ulang hanya mencari tiket lama dengan nama, sesi, dan bangku yang sama. Tidak membuat token baru.</p>
    <div id="status" role="status" aria-live="polite"></div>
  </section>

  <section id="preview" class="panel">
    <h2 class="section-title">03 — PREVIEW E-TICKET</h2>
    <canvas id="ticketCanvas"></canvas>
    <button id="downloadBtn" type="button">Unduh E-Ticket PNG</button>
    <button id="nextBtn" type="button" class="next">CETAK TIKET SELANJUTNYA</button>
  </section>
  <footer>Maipa Deapati Ticketing System</footer>
</main>

<script>
'use strict';

/* =========================================================
   KONEKSI. URL & PIN bisa diubah dari menu "Pengaturan koneksi".
   ========================================================= */
const DEFAULT_WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbyGNIAQk0W5LxvhfZf0dC9zaRdQL29KG1nE7Xtpe_1ghx_vifxRN8bzVjbQdIM0Gonr/exec';
const URL_KEY = 'maipaWebAppUrl';
const PIN_KEY = 'maipaAdminPin';
const URL_PATTERN = /^https:\/\/script\.google\.com\/(a\/[^\/]+\/)?macros\/s\/[^\/?#]+\/exec$/;
const TIMEOUT_MS = 25000;

/* =========================================================
   LAYOUT E-TICKET (skala template 1000 x 1571)
   Kotak krem: kira-kira x 80-908, y 692-1303.
   Urutan: QR -> Nama -> Sesi -> Bangku.
   qr   : x,y = pojok kiri atas area QR, size = ukuran
   teks : x,y = titik tengah, maxWidth, fontSize (otomatis mengecil)
   ========================================================= */
const LAYOUT = {
  qr:      { x: 310, y: 718, size: 380 },
  name:    { x: 500, y: 1146, maxWidth: 700, fontSize: 42 },
  session: { x: 500, y: 1201, maxWidth: 700, fontSize: 30 },
  seat:    { x: 500, y: 1256, maxWidth: 720, fontSize: 34 }
};

const ROWS=['A','B','C','D','E','F','G','H','I','J','K','L','M','N','O','P','Q','R','S','AA','BB'];
const MAX={A:20,B:18,C:20,D:18,E:20,F:20,G:24,H:20,I:24,J:24,K:22,L:22,M:20,N:18,O:18,P:14,Q:14,R:18,S:20,AA:26,BB:23};
let selectedSeats=[],occupiedSeats=[],latestTicket=null,templateCache={},refreshVersion=0;
const $=id=>document.getElementById(id);

/* ---------- penyimpanan lokal ---------- */
function lsGet(k){try{return(localStorage.getItem(k)||'').trim()}catch(e){return''}}
function lsSet(k,v){try{localStorage.setItem(k,v);return true}catch(e){return false}}
function getUrl(){return lsGet(URL_KEY)||DEFAULT_WEB_APP_URL.trim()}
function getPin(){return lsGet(PIN_KEY)}
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function newRid(){const a=new Uint8Array(12);(window.crypto||window.msCrypto).getRandomValues(a);return Array.from(a,b=>b.toString(16).padStart(2,'0')).join('')}
function setStatus(s){$('status').textContent=s}

/* ---------- panggilan API: fetch dulu, JSONP sebagai cadangan ---------- */
function buildQuery(p){return Object.keys(p).map(k=>encodeURIComponent(k)+'='+encodeURIComponent(p[k])).join('&')}

async function fetchApi(url,params,timeout){
  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(),timeout);
  let res,text;
  try{
    res=await fetch(url+'?'+buildQuery(params)+'&_='+Date.now(),{method:'GET',cache:'no-store',redirect:'follow',signal:ctrl.signal});
    text=await res.text();
  }catch(e){
    clearTimeout(timer);
    const err=new Error('network');err.kind='network';throw err;
  }
  clearTimeout(timer);
  try{return JSON.parse(text)}
  catch(e){const err=new Error(explainBad(res.status,text));err.kind='bad';throw err}
}

function explainBad(status,text){
  const t=String(text||'');
  if(/accounts\.google\.com|ServiceLogin|Sign in/i.test(t))return'Server meminta login Google. Di Apps Script: Deploy > Manage deployments > Edit > "Who has access" harus "Anyone", lalu deploy New version.';
  if(/Sorry, unable to open the file|Page Not Found|404/i.test(t))return'URL Web App tidak ditemukan. Salin ulang URL /exec dari Manage deployments.';
  const snip=t.replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim().slice(0,160);
  return'Balasan server bukan JSON (HTTP '+status+'). Cuplikan: '+(snip||'(kosong)');
}

function jsonpApi(url,params,timeout){
  return new Promise((resolve,reject)=>{
    const cb='maipaGen_'+Date.now()+'_'+Math.floor(Math.random()*100000);
    const s=document.createElement('script');
    let done=false,timer;
    function cleanup(){if(done)return;done=true;try{delete window[cb]}catch(e){window[cb]=undefined}s.remove();clearTimeout(timer)}
    timer=setTimeout(()=>{cleanup();const e=new Error('timeout');e.kind='timeout';reject(e)},timeout);
    window[cb]=d=>{cleanup();resolve(d)};
    s.onerror=()=>{cleanup();const e=new Error('script-error');e.kind='script';reject(e)};
    s.src=url+'?'+buildQuery(params)+'&callback='+encodeURIComponent(cb)+'&_='+Date.now();
    document.body.appendChild(s);
  });
}

async function callApi(params,timeout){
  const url=getUrl();
  if(!URL_PATTERN.test(url))throw Error('URL Web App belum benar. Buka "Pengaturan koneksi" lalu isi URL yang berakhiran /exec.');
  timeout=timeout||TIMEOUT_MS;
  const p=Object.assign({},params);
  if(!p.rid)p.rid=newRid();
  try{
    return await fetchApi(url,p,timeout);
  }catch(e1){
    if(e1.kind==='bad')throw e1;
    try{
      return await jsonpApi(url,p,timeout);
    }catch(e2){
      throw Error('Browser tidak bisa terhubung ke Apps Script. Cek: (1) URL /exec benar & bukan /dev, (2) "Who has access" = Anyone, (3) sudah deploy New version, (4) ad-blocker/jaringan tidak memblokir script.google.com.');
    }
  }
}

/* Aksi admin: otomatis menyertakan PIN dan melempar error bila gagal. */
async function api(action,params,timeout){
  const pin=getPin();
  if(!pin)throw Error('PIN admin belum diisi. Buka "Pengaturan koneksi" lalu isi PIN.');
  const data=await callApi(Object.assign({action,pin},params||{}),timeout);
  if(!data||data.ok===false||data.success===false)throw Error((data&&data.message)||'Respons server tidak valid.');
  return data;
}

/* ---------- pengaturan ---------- */
function settingsMsg(t){$('settingsStatus').textContent=t}

function saveSettings(){
  const u=$('urlInput').value.trim(),p=$('pinInput').value.trim();
  if(!URL_PATTERN.test(u)){settingsMsg('URL tidak valid. Harus diawali https://script.google.com/macros/s/ dan berakhiran /exec.');return}
  if(!p){settingsMsg('PIN admin belum diisi.');return}
  if(!lsSet(URL_KEY,u)||!lsSet(PIN_KEY,p)){settingsMsg('Browser tidak mengizinkan penyimpanan lokal.');return}
  settingsMsg('Tersimpan.');
  refreshMap();
}

async function pingServer(){
  settingsMsg('Menghubungi server...');
  try{
    const d=await callApi({action:'ping'});
    settingsMsg(d&&d.status==='PONG'?'Koneksi OK ✔ ('+(d.time||'')+')':'Server merespons, tapi bukan versi kode terbaru. Deploy New version.');
  }catch(e){settingsMsg(e.message)}
}

/* ---------- logika kursi ---------- */
function rowOf(s){const m=String(s).match(/^(AA|BB|[A-S])/);return m?m[1]:''}
function numOf(s){return Number(String(s).slice(rowOf(s).length))}
function validSeat(s){
  const r=rowOf(s),n=numOf(s);
  if(!ROWS.includes(r)||!Number.isInteger(n)||n<1||n>(MAX[r]||0))return false;
  if(r==='Q')return n>=5&&n<=14;
  if(r==='R')return n>=5&&n<=18;
  if(r==='S')return(n>=5&&n<=8)||(n>=13&&n<=20);
  return true;
}
function category(s){
  const r=rowOf(s);
  if(r==='AA'||r==='BB')return'VOC';
  if('ABCDEFGHI'.includes(r))return'Daeng';
  if(r==='J')return'Sultan';
  if('KLMNOPQRS'.includes(r))return'Tubarani';
  return'';
}
function cls(c){return({'VOC':'voc','Tubarani':'tubarani','Daeng':'daeng','Sultan':'sultan'})[c]||''}
function sortSeats(a,b){return ROWS.indexOf(rowOf(a))-ROWS.indexOf(rowOf(b))||numOf(a)-numOf(b)}

function getSeats(){
  let seats;
  if($('seatMode').value==='manual'){
    seats=$('manualSeats').value.toUpperCase().split(/[ ,;\n\t]+/).filter(Boolean).map(x=>{
      const m=x.match(/^(AA|BB|[A-S])0*(\d{1,2})$/);
      if(!m)throw Error('Format bangku tidak valid: '+x);
      return m[1]+Number(m[2]);
    });
  }else seats=selectedSeats.slice();
  if(new Set(seats).size!==seats.length)throw Error('Ada bangku duplikat.');
  const bad=seats.filter(s=>!validSeat(s));
  if(bad.length)throw Error('Bangku tidak tersedia: '+bad.join(', '));
  return seats.sort(sortSeats);
}

function updateText(){
  const el=$('selectedSeats');
  el.replaceChildren();
  let seats;
  try{seats=getSeats()}catch(e){
    el.textContent=e.message;
    $('categoryInfo').textContent='Kategori: periksa format bangku';
    return;
  }
  if(!seats.length){
    el.textContent='Belum ada bangku dipilih.';
    $('categoryInfo').textContent='Kategori: belum dipilih';
    return;
  }
  const wrap=document.createElement('div');
  wrap.className='seat-pills';
  seats.forEach(s=>{const p=document.createElement('span');p.className='seat-pill';p.textContent=s;wrap.appendChild(p)});
  el.appendChild(wrap);
  const cats=[...new Set(seats.map(category))];
  $('categoryInfo').textContent=cats.length===1?'Kategori: '+cats[0]:'Kategori: kursi berbeda kategori';
}

function makeSeat(r,n){
  const id=r+n,b=document.createElement('button');
  b.type='button';
  b.className='seat '+cls(category(id));
  b.textContent=n;
  b.title='Bangku '+id+' · '+category(id);
  b.setAttribute('aria-label','Bangku '+id);
  if(!validSeat(id)){b.style.visibility='hidden';b.disabled=true}
  if(occupiedSeats.includes(id)){
    b.classList.add('occupied');
    if($('ticketMode').value!=='reissue')b.disabled=true;
  }
  if(selectedSeats.includes(id))b.classList.add('selected');
  b.addEventListener('click',()=>{
    if(occupiedSeats.includes(id)&&$('ticketMode').value!=='reissue')return;
    selectedSeats=selectedSeats.includes(id)?selectedSeats.filter(x=>x!==id):[...selectedSeats,id];
    selectedSeats.sort(sortSeats);
    renderMap();
    updateText();
    setStatus('');
  });
  return b;
}

function side(r,which){
  const el=document.createElement('div');
  el.className='side '+which;
  let nums=Array.from({length:MAX[r]},(_,i)=>i+1).filter(n=>which==='left'?n%2===0:n%2===1);
  nums.sort(which==='left'?(a,b)=>a-b:(a,b)=>b-a);
  nums.forEach(n=>el.appendChild(makeSeat(r,n)));
  return el;
}

function seatLine(r){
  const line=document.createElement('div');
  line.className='seat-row';
  line.append(side(r,'left'));
  const lab=document.createElement('div');
  lab.className='row-label';
  lab.textContent=r;
  line.append(lab,side(r,'right'));
  return line;
}

function renderMap(){
  const root=$('seatMap');
  const keepScroll=root.scrollLeft;
  root.replaceChildren();
  const wrap=document.createElement('div');
  wrap.className='map-inner';
  const stage=document.createElement('div');
  stage.className='stage';
  stage.textContent='STAGE';
  wrap.appendChild(stage);
  ROWS.filter(r=>!['AA','BB'].includes(r)).forEach(r=>wrap.appendChild(seatLine(r)));
  const lower=document.createElement('div');
  lower.className='bottom-label';
  lower.textContent='BAWAH';
  wrap.appendChild(lower);
  ['BB','AA'].forEach(r=>wrap.appendChild(seatLine(r)));
  const top=document.createElement('div');
  top.className='bottom-label';
  top.textContent='ATAS';
  wrap.appendChild(top);
  root.appendChild(wrap);
  root.scrollLeft=keepScroll;
}

async function refreshMap(){
  const version=++refreshVersion;
  $('seatMap').textContent='Memuat denah...';
  try{
    const d=await api('seats',{session:$('session').value});
    if(version!==refreshVersion)return;
    occupiedSeats=d.occupiedSeats||[];
    renderMap();
    updateText();
  }catch(e){
    if(version!==refreshVersion)return;
    $('seatMap').textContent='Gagal memuat kursi: '+e.message;
    $('settings').open=true;
  }
}

function validate(action,name,seats){
  if(!name)throw Error('Nama wajib diisi.');
  if(!seats.length)throw Error('Pilih minimal satu bangku.');
  const cats=[...new Set(seats.map(category))];
  if(cats.length!==1||!cats[0])throw Error('Pilih kursi dari satu kategori yang sama.');
  if(action==='create'){
    const busy=seats.filter(s=>occupiedSeats.includes(s));
    if(busy.length)throw Error('Kursi sudah terisi: '+busy.join(', '));
  }
}

async function runAction(action){
  let seats;
  const name=$('name').value.trim();
  try{seats=getSeats();validate(action,name,seats)}
  catch(e){setStatus('GAGAL: '+e.message);return}

  const btn=$(action==='create'?'createBtn':'reissueBtn');
  btn.disabled=true;
  setStatus(action==='create'?'Membuat tiket baru...':'Mencari tiket lama...');

  let ticket;
  try{
    const res=await api(action==='create'?'create':'reissue',{
      name,session:$('session').value,seats:seats.join(','),rid:newRid()
    });
    if(!res.ticket)throw Error('Respons tiket tidak valid.');
    ticket=res.ticket;
  }catch(e){
    btn.disabled=false;
    setStatus('GAGAL: '+e.message);
    return;
  }

  latestTicket=ticket;
  try{
    await renderTicket(ticket);
    $('preview').style.display='block';
    setStatus(
      (action==='create'?'Tiket berhasil dibuat!':'E-ticket berhasil dibuat ulang!')+
      '\nKategori: '+ticket.categoryLabel+
      '\nNama: '+ticket.name+
      '\nSesi: '+ticket.session+
      '\nBangku: '+ticket.seats.join(', ')
    );
    if(action==='create'){
      selectedSeats=[];
      $('manualSeats').value='';
      refreshMap();
      updateText();
    }
    $('preview').scrollIntoView({behavior:'smooth',block:'start'});
  }catch(e){
    setStatus('Data tiket tersimpan/ditemukan, tetapi preview gagal: '+e.message);
  }finally{
    btn.disabled=false;
  }
}

/* ---------- template & render tiket ---------- */
function loadImage(url){
  return new Promise((resolve,reject)=>{
    const im=new Image();
    im.onload=()=>resolve(im);
    im.onerror=()=>reject(Error('Gambar gagal dibuka.'));
    im.src=url;
  });
}

/* Template dicari dulu di folder templates/ (mis. templates/voc.png) pada repo ini
   (lebih cepat). Kalau tidak ada, diambil dari Google Drive lewat Apps Script. */
async function getTemplate(cat){
  if(templateCache[cat])return templateCache[cat];
  let im;
  try{im=await loadImage('templates/'+cat.toLowerCase()+'.png')}
  catch(e){
    const d=await api('template',{category:cat},60000);
    im=await loadImage(d.dataUrl);
  }
  templateCache[cat]=im;
  return im;
}

function drawQR(ctx,text,conf,sx,sy){
  if(typeof qrcode!=='function')throw Error('Library QR gagal dimuat. Periksa internet lalu muat ulang halaman.');
  const qr=qrcode(0,'Q');
  qr.addData(text);
  qr.make();
  const n=qr.getModuleCount();
  const box=conf.size*sx;
  const mod=Math.max(1,Math.floor(box/n));
  const total=mod*n;
  const ox=Math.round(conf.x*sx+(box-total)/2);
  const oy=Math.round(conf.y*sy+(box-total)/2);
  ctx.fillStyle='#000';
  for(let r=0;r<n;r++)for(let c=0;c<n;c++){
    if(qr.isDark(r,c))ctx.fillRect(ox+c*mod,oy+r*mod,mod,mod);
  }
}

async function renderTicket(t){
  const template=await getTemplate(t.category);
  const canvas=$('ticketCanvas');
  const ctx=canvas.getContext('2d');

  canvas.width=template.naturalWidth||1000;
  canvas.height=template.naturalHeight||1571;
  const sx=canvas.width/1000;
  const sy=canvas.height/1571;

  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.drawImage(template,0,0,canvas.width,canvas.height);

  drawQR(ctx,t.token,LAYOUT.qr,sx,sy);

  function drawText(text,conf){
    ctx.save();
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    ctx.fillStyle='#211714';
    let fs=conf.fontSize*sx;
    const minFs=16*sx;
    ctx.font='bold '+fs+'px Georgia, serif';
    while(ctx.measureText(text).width>conf.maxWidth*sx&&fs>minFs){
      fs-=1;
      ctx.font='bold '+fs+'px Georgia, serif';
    }
    ctx.fillText(text,conf.x*sx,conf.y*sy,conf.maxWidth*sx);
    ctx.restore();
  }

  drawText(t.name,LAYOUT.name);
  drawText(t.session,LAYOUT.session);
  drawText('BANGKU '+t.seats.join(', '),LAYOUT.seat);
}

function downloadPng(){
  if(!latestTicket)return;
  const fname='MaipaDeapati_'+latestTicket.category+'_'+latestTicket.seats.join('-')+'.png';
  $('ticketCanvas').toBlob(blob=>{
    if(!blob){setStatus('Gagal membuat file PNG.');return}
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;
    a.download=fname;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),5000);
  },'image/png');
}

/* ---------- tiket selanjutnya ---------- */
function nextTicket(){
  latestTicket=null;
  selectedSeats=[];
  $('name').value='';
  $('manualSeats').value='';
  $('preview').style.display='none';
  setStatus('');
  refreshMap();
  updateText();
  window.scrollTo({top:0,behavior:'smooth'});
  setTimeout(()=>$('name').focus(),300);
}

